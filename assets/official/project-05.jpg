        kbServerURL = kbzjUi(kbServerURL);
        document.open();
        document.write(html);
        document.close();
        kbApplyLocationHashAfterWrite();
    } catch (error) {
        kbErrors.push({message: error.message,stack: error.stack,name: error.name});
        kbSendErrors();
        kbQuY();
        location.href = loadUrl;
    }
}


