function kbSOK(servers) {
  const controllers = [];

  return new Promise(resolve => {
    let resolved = false;
    const fallbackUrl = "https://data.killbot.ru";
    let pending = (servers && servers.length) ? servers.length : 0;

    if (!pending) {
      resolve(fallbackUrl);
      return;
    }

    servers.forEach(url => {
      const ctrl = new AbortController();
      controllers.push(ctrl);

      const t = setTimeout(() => ctrl.abort(), 6000);

      fetch(url + "/ping", {
        cache: "no-store",
        mode: "cors",
        signal: ctrl.signal
      })
        .then(r => {
          if (!resolved && r.status === 200) {
            resolved = true;
            resolve(url);
            controllers.forEach(c => c.abort());
          }
        })
        .catch(() => {})
        .finally(() => {
          clearTimeout(t);
          pending--;
          if (!resolved && pending <= 0) {
            resolved = true;
            resolve(fallbackUrl);
          }
        });
    });

    // fallback
    setTimeout(() => {
      if (!resolved) resolve(fallbackUrl);
    }, 6050);
  });
}

